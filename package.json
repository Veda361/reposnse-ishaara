{
  "name": "isahara-backend",
  "version": "1.0.0",
  "description": "Backend API for Isahara college transportation validation research platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "test": "NODE_ENV=test tsx --test src/**/*.test.ts",
    "test:phase08": "NODE_ENV=test tsx --test src/modules/vehicles/__tests__/vehicle-assignment-phase08.test.ts",
    "test:phase09": "NODE_ENV=test tsx --test src/modules/trips/__tests__/trip-phase09.test.ts",
    "test:phase10": "NODE_ENV=test tsx --test src/modules/ride-requests/__tests__/ride-lifecycle-phase10.test.ts",
    "test:phase12": "NODE_ENV=test tsx --test src/modules/payments/__tests__/phase12-pricing-billing.test.ts",
    "test:phase13": "NODE_ENV=test tsx --test src/modules/payments/__tests__/phase13-payment-processing.test.ts",
    "test:phase14": "NODE_ENV=test tsx --test --test-concurrency=1 src/modules/safety/__tests__/*.test.ts src/modules/ratings/__tests__/*.test.ts",
    "test:phase15": "NODE_ENV=test tsx --test src/modules/notifications/__tests__/device-token.test.ts src/modules/notifications/__tests__/notification.api.test.ts src/modules/notifications/__tests__/notification.orchestrator.test.ts src/modules/notifications/__tests__/notification.concurrency.test.ts src/modules/notifications/__tests__/notification.integration.test.ts",
    "test:phase16": "NODE_ENV=test tsx --test src/modules/drivers/__tests__/phase16-driver-earnings.test.ts",
    "test:phase17": "NODE_ENV=test tsx --test src/modules/payments/__tests__/phase17-settlement-engine.test.ts src/modules/payments/__tests__/phase17-qr-settlement.test.ts",
    "start": "node dist/server.js",
    "lint:check": "echo 'Lint: ESLint is not configured in this project. TypeScript strict-mode compilation (tsc --noEmit) serves as the static analysis gate. Run: npm run typecheck' && exit 0",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "isahara",
    "survey",
    "express",
    "typescript",
    "mongodb",
    "mongoose"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "better-auth": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^14.4.0",
    "helmet": "^8.0.0",
    "json2csv": "^6.0.0-alpha.2",
    "mongodb": "^7.6.0",
    "mongoose": "^8.10.1",
    "multer": "^2.4.0",
    "razorpay": "^2.9.8",
    "ws": "^8.21.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/json2csv": "^5.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.2",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "supertest": "^7.2.2",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3"
  }
}

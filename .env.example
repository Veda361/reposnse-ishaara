# Environment Configuration
NODE_ENV=development
PORT=5000

# MongoDB Connection String (Local development default)
MONGODB_URI=mongodb://127.0.0.1:27017/isahara

# MongoDB Atlas Example for Production:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.w5zdool.mongodb.net/isahara?retryWrites=true&w=majority&appName=Cluster0

# Frontend URL (Client origin allowed by CORS)
CLIENT_URL=http://localhost:3000

# Secret key known only to the administrator for /api/v1/admin/* routes
ADMIN_SECRET_KEY=replace_with_secure_secret

# Phase 1: Authentication & Better Auth Configuration
BETTER_AUTH_SECRET=replace_with_a_secure_random_secret_at_least_32_characters
BETTER_AUTH_URL=http://localhost:5000

# Google OAuth 2.0 Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Phase 4: Location System & Geospatial Providers
GOOGLE_MAPS_API_KEY=your_google_maps_platform_web_service_api_key
SERPAPI_API_KEY=your_serpapi_api_key
GOOGLE_MAPS_ENABLED=true
SERPAPI_ENABLED=true
LOCATION_PRIMARY_PROVIDER=google_maps
LOCATION_TIMEOUT_MS=5000
LOCATION_CACHE_TTL_SECONDS=600

# Phase 6: Voice-First Driver System Configuration
SPEECH_PRIMARY_PROVIDER=google
SPEECH_FALLBACK_PROVIDER=openai
SPEECH_TIMEOUT_MS=10000
VOICE_MAX_AUDIO_MB=5
VOICE_MAX_DURATION_SECONDS=30
VOICE_DRAFT_TTL_MINUTES=15

# Google Speech-to-Text (server-side credentials)
GOOGLE_STT_API_KEY=your_google_cloud_stt_api_key
GOOGLE_CLOUD_PROJECT_ID=your_google_cloud_project_id
GOOGLE_SPEECH_MODEL=chirp_2

# OpenAI Speech-to-Text (Whisper API)
OPENAI_API_KEY=your_openai_api_key
OPENAI_SPEECH_MODEL=whisper-1

# Self-Hosted Whisper Inference Service
WHISPER_BASE_URL=http://localhost:8000
WHISPER_API_KEY=optional_whisper_internal_api_key
WHISPER_MODEL=turbo

# NLP / Intent Extraction Provider
INTENT_PROVIDER=deterministic
INTENT_MODEL=gpt-4o-mini

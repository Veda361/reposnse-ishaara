# Environment Configuration
NODE_ENV=development
PORT=5000

# MongoDB Connection String (Local development default)
MONGODB_URI=mongodb://127.0.0.1:27017/isahara

# MongoDB Atlas Example for Production:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.w5zdool.mongodb.net/isahara?retryWrites=true&w=majority&appName=Cluster0

# Frontend URL (Client origin allowed by CORS)
CLIENT_URL=http://localhost:3000

# Secret key known only to the administrator for /api/v1/admin/* routes
ADMIN_SECRET_KEY=replace_with_secure_secret

# Phase 1: Authentication & Better Auth Configuration
BETTER_AUTH_SECRET=replace_with_a_secure_random_secret_at_least_32_characters
BETTER_AUTH_URL=http://localhost:5000

# Resend Email Configuration (Production OTP delivery)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=onboarding@resend.dev

# Google OAuth 2.0 Credentials (from Google Cloud Console)
# Native Android OAuth Client ID (for Android Credential Manager / GetGoogleIdOption)
GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
# Web Application OAuth Client ID (for Better Auth server-side Google provider)
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# Web Application Client Secret (server-side only, NEVER expose to Android client)
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Legacy fallback (deprecated, use GOOGLE_WEB_CLIENT_ID instead)
# GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Phase 01: Google Maps Platform — Server-Side Credential Architecture
# Each server-side key must be independently restricted in Google Cloud Console to its respective API.
# NEVER expose these server-side keys to Android clients, browsers, or public API responses.

# 1. Google Places API (Used by LocationService for place search / autocomplete)
# Allowed Google Cloud API: "Places API" / "Places API (New)"
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# 2. Google Routes API (Used by RoutingService for driving / two-wheeler route calculations)
# Allowed Google Cloud API: "Routes API" / "Directions API"
GOOGLE_ROUTES_API_KEY=your_google_routes_api_key

# 3. Google Geocoding API (Used by LocationService for address resolution & reverse geocoding)
# Allowed Google Cloud API: "Geocoding API"
GOOGLE_GEOCODING_API_KEY=your_google_geocoding_api_key

# 4. Google Roads API (Used for driver GPS telemetry snap-to-roads and map matching)
# Allowed Google Cloud API: "Roads API"
GOOGLE_ROADS_API_KEY=your_google_roads_api_key

# Client-Side Android Maps SDK (Documented here for architectural clarity; NEVER read by backend code)
# Allowed Google Cloud API: "Maps SDK for Android"
# Application Restriction: Android package name + SHA-1 certificate fingerprint
# GOOGLE_ANDROID_SDK_API=your_android_maps_sdk_client_key

# Legacy universal key fallback (deprecated; to be removed in future phases)
# GOOGLE_MAPS_API_KEY=your_legacy_universal_google_maps_key

# Location System Configuration (Multi-Provider Orchestration & Fallback)
SERPAPI_API_KEY=your_serpapi_api_key
GOOGLE_MAPS_ENABLED=true
SERPAPI_ENABLED=true
LOCATION_PRIMARY_PROVIDER=google_maps
LOCATION_FALLBACK_PROVIDER=serpapi
LOCATION_TIMEOUT_MS=5000
LOCATION_CACHE_TTL_SECONDS=600

# Routing System Configuration
ROUTING_PROVIDER=google_routes
ROUTING_TIMEOUT_MS=5000
ROUTING_CACHE_TTL_SECONDS=3600

# Phase 6: Voice-First Driver System Configuration
SPEECH_PRIMARY_PROVIDER=whisper
SPEECH_FALLBACK_PROVIDER=openai
SPEECH_TIMEOUT_MS=10000
VOICE_MAX_AUDIO_MB=5
VOICE_MAX_DURATION_SECONDS=30
VOICE_DRAFT_TTL_MINUTES=15

# Google Speech-to-Text (server-side credentials)
GOOGLE_STT_API_KEY=your_google_cloud_stt_api_key
GOOGLE_CLOUD_PROJECT_ID=your_google_cloud_project_id
GOOGLE_SPEECH_MODEL=chirp_2

# OpenAI Speech-to-Text (Whisper API)
OPENAI_API_KEY=your_openai_api_key
OPENAI_SPEECH_MODEL=whisper-1

# Self-Hosted Whisper Inference Service
WHISPER_BASE_URL=http://localhost:8000
WHISPER_API_KEY=your_whisper_api_key
WHISPER_MODEL=base

# NLP / Intent Extraction Provider
INTENT_PROVIDER=deterministic
INTENT_MODEL=gpt-4o-mini
